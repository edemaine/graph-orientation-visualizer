import { For, Show, batch, createEffect, createMemo, createSignal, onCleanup } from "solid-js";
import { EXAMPLES } from "./examples.civet";
import graphStyles from "./graph.sass?inline";
import {
  type Constraint,
  type Edge,
  type EdgeDirection,
  type EdgeEnd,
  type GraphDefinition,
  type Vertex,
  analyzeVertex,
  emptyDirections,
  incidencesAt,
} from "./model.civet";

const NODE_RADIUS = 29;
const NODE_EDGE_PADDING = NODE_RADIUS + 4;
const EXTERNAL_EDGE_PADDING = 7;

export interface Point { x: number; y: number }
type Theme = "light" | "dark";
type DirectionState = Record<string, EdgeDirection>;
type DirectionUpdate = DirectionState | ((current: DirectionState) => DirectionState);
interface LabelPart { text: string; italic: boolean }

const EDGE_SWIPE_MINIMUM_PIXELS = 12;
const EDGE_SWIPE_MINIMUM_FRACTION = 0.004;

const THEME_STORAGE_KEY = "graph-orientation-theme";
const SVG_NAMESPACE = "http://www.w3.org/2000/svg";
const XMLNS_NAMESPACE = "http://www.w3.org/2000/xmlns/";
const SVG_XML_PREAMBLE = '<?xml version="1.0" encoding="UTF-8"?>';
const GRAPH_STYLE_PROPERTIES = [
  "--font-family",
  "--graph-neutral",
  "--primary",
  "--cyan",
  "--selection-glow",
  "--red",
  "--paper",
  "--ink",
  "--node-surface",
  "--canvas-background",
  "--forced-surface",
  "--satisfied-surface",
  "--impossible-surface",
  "--green",
  "--on-accent",
] as const;

export const parseLabelMarkup = (label: string): LabelPart[] => {
  const parts: LabelPart[] = [];
  const italic = /<i>(.*?)<\/i>/g;
  let cursor = 0;
  for (const match of label.matchAll(italic)) {
    if (match.index > cursor) parts.push({ text: label.slice(cursor, match.index), italic: false });
    parts.push({ text: match[1], italic: true });
    cursor = match.index + match[0].length;
  }
  if (cursor < label.length) parts.push({ text: label.slice(cursor), italic: false });
  return parts.length ? parts : [{ text: label, italic: false }];
};

const plainLabel = (label: string) => {
  return parseLabelMarkup(label).map(({ text }) => text).join("");
};

export const platformUsesCommandKey = (platform: string) => {
  return /mac|iphone|ipad|ipod/i.test(platform);
};

const detectedPlatform = () => {
  const userAgentData = (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData;
  return userAgentData?.platform || navigator.platform || navigator.userAgent;
};

export const serializeGraphSvg = (source: SVGSVGElement, theme: Theme): string => {
  const svg = source.cloneNode(true) as SVGSVGElement;
  if (!svg.hasAttribute("xmlns")) svg.setAttributeNS(XMLNS_NAMESPACE, "xmlns", SVG_NAMESPACE);
  svg.setAttribute("data-theme", theme);

  const viewBox = svg.getAttribute("viewBox")?.trim().split(/[ ,]+/).map(Number);
  if (viewBox?.length === 4 && viewBox.every(Number.isFinite)) {
    if (!svg.hasAttribute("width")) svg.setAttribute("width", String(viewBox[2]));
    if (!svg.hasAttribute("height")) svg.setAttribute("height", String(viewBox[3]));
  }

  const computedStyle = getComputedStyle(source);
  for (const property of GRAPH_STYLE_PROPERTIES) {
    const value = computedStyle.getPropertyValue(property);
    if (value) svg.style.setProperty(property, value);
  }

  const style = document.createElementNS(SVG_NAMESPACE, "style");
  style.setAttribute("data-svg-export", "");
  style.textContent = graphStyles;
  svg.prepend(style);

  return `${SVG_XML_PREAMBLE}\n${new XMLSerializer().serializeToString(svg)}\n`;
};

const initialTheme = (): Theme => {
  try {
    const saved = window.localStorage.getItem(THEME_STORAGE_KEY);
    if (saved === "light" || saved === "dark") return saved;
  } catch {
    // Storage can be unavailable in privacy-restricted contexts.
  }
  return window.matchMedia?.("(prefers-color-scheme: dark)").matches ? "dark" : "light";
};

const endpointPoint = (graph: GraphDefinition, end: EdgeEnd): Point => {
  if ("vertex" in end) {
    const vertex = graph.vertices.find(({ id }) => id === end.vertex);
    if (!vertex) throw new Error(`Missing vertex ${end.vertex}`);
    return { x: vertex.x, y: vertex.y };
  }
  return end;
};

const unit = (point: Point): Point => {
  const length = Math.hypot(point.x, point.y) || 1;
  return { x: point.x / length, y: point.y / length };
};

const edgeGeometry = (graph: GraphDefinition, edge: Edge) => {
  const rawStart = endpointPoint(graph, edge.ends[0]);
  const rawEnd = endpointPoint(graph, edge.ends[1]);
  const firstWaypoint = edge.route?.[0];
  const lastWaypoint = edge.route?.[edge.route.length - 1];
  const startDirection = edge.control
    ? unit({ x: edge.control.x - rawStart.x, y: edge.control.y - rawStart.y })
    : unit({
        x: (firstWaypoint ?? rawEnd).x - rawStart.x,
        y: (firstWaypoint ?? rawEnd).y - rawStart.y,
      });
  const endDirection = edge.control
    ? unit({ x: rawEnd.x - edge.control.x, y: rawEnd.y - edge.control.y })
    : unit({
        x: rawEnd.x - (lastWaypoint ?? rawStart).x,
        y: rawEnd.y - (lastWaypoint ?? rawStart).y,
      });
  const startPadding = "vertex" in edge.ends[0] ? NODE_EDGE_PADDING : EXTERNAL_EDGE_PADDING;
  const endPadding = "vertex" in edge.ends[1] ? NODE_EDGE_PADDING : EXTERNAL_EDGE_PADDING;
  const start = {
    x: rawStart.x + startDirection.x * startPadding,
    y: rawStart.y + startDirection.y * startPadding,
  };
  const end = {
    x: rawEnd.x - endDirection.x * endPadding,
    y: rawEnd.y - endDirection.y * endPadding,
  };
  if (edge.control) {
    const middle = ` Q ${edge.control.x} ${edge.control.y}`;
    const forward = `M ${start.x} ${start.y}${middle} ${end.x} ${end.y}`;
    const reverse = `M ${end.x} ${end.y}${middle} ${start.x} ${start.y}`;
    const midpoint = {
      x: 0.25 * start.x + 0.5 * edge.control.x + 0.25 * end.x,
      y: 0.25 * start.y + 0.5 * edge.control.y + 0.25 * end.y,
    };
    return { start, end, midpoint, forward, reverse };
  }

  const points = [start, ...(edge.route ?? []), end];
  const path = (pathPoints: Point[]) => {
    return `M ${pathPoints.map(({ x, y }) => `${x} ${y}`).join(" L ")}`;
  };
  const lengths = points.slice(1).map((point, index) => {
    return Math.hypot(point.x - points[index].x, point.y - points[index].y);
  });
  const halfway = lengths.reduce((sum, length) => sum + length, 0) / 2;
  let traversed = 0;
  let midpoint = { ...start };
  for (let index = 0; index < lengths.length; index += 1) {
    const length = lengths[index];
    if (traversed + length >= halfway) {
      const fraction = length === 0 ? 0 : (halfway - traversed) / length;
      midpoint = {
        x: points[index].x + fraction * (points[index + 1].x - points[index].x),
        y: points[index].y + fraction * (points[index + 1].y - points[index].y),
      };
      break;
    }
    traversed += length;
  }
  const forward = path(points);
  const reverse = path([...points].reverse());
  return { start, end, midpoint, forward, reverse };
};

const eventPoint = (event: MouseEvent | PointerEvent, path: SVGPathElement): Point => {
  const svg = path.ownerSVGElement;
  const matrix = svg?.getScreenCTM();
  if (!svg || !matrix) return { x: 0, y: 0 };
  const point = svg.createSVGPoint();
  point.x = event.clientX;
  point.y = event.clientY;
  const local = point.matrixTransform(matrix.inverse());
  return { x: local.x, y: local.y };
};

const closestFraction = (path: SVGPathElement, point: Point): number => {
  const length = path.getTotalLength();
  let bestFraction = 0;
  let bestDistance = Number.POSITIVE_INFINITY;
  for (let step = 0; step <= 60; step += 1) {
    const fraction = step / 60;
    const sample = path.getPointAtLength(length * fraction);
    const distance = (sample.x - point.x) ** 2 + (sample.y - point.y) ** 2;
    if (distance < bestDistance) {
      bestDistance = distance;
      bestFraction = fraction;
    }
  }
  let radius = 1 / 60;
  for (let pass = 0; pass < 2; pass += 1) {
    const start = Math.max(0, bestFraction - radius);
    const end = Math.min(1, bestFraction + radius);
    for (let step = 0; step <= 12; step += 1) {
      const fraction = start + (end - start) * step / 12;
      const sample = path.getPointAtLength(length * fraction);
      const distance = (sample.x - point.x) ** 2 + (sample.y - point.y) ** 2;
      if (distance < bestDistance) {
        bestDistance = distance;
        bestFraction = fraction;
      }
    }
    radius /= 12;
  }
  return bestFraction;
};

export const edgeSwipeDirection = (
  startFraction: number,
  endFraction: number,
  startPoint: Point,
  endPoint: Point,
): 0 | 1 | null => {
  const distance = Math.hypot(endPoint.x - startPoint.x, endPoint.y - startPoint.y);
  const progress = endFraction - startFraction;
  if (distance < EDGE_SWIPE_MINIMUM_PIXELS || Math.abs(progress) < EDGE_SWIPE_MINIMUM_FRACTION) return null;
  return progress > 0 ? 1 : 0;
};

const directionLabel = (edge: Edge, direction: 0 | 1): string => {
  const end = edge.ends[direction];
  return "vertex" in end ? `toward ${end.vertex}` : "toward the dangling end";
};

const constraintRule = (constraint: Constraint): string => {
  const exact = /^(\d+)-in-(\d+)$/.exec(constraint.name);
  if (exact) return `Exactly ${exact[1]} of ${exact[2]} edges point inward`;
  if (constraint.name === `{0,${constraint.degree}}-in-${constraint.degree}`) {
    return "All edges point inward or all point outward";
  }
  if (constraint.name === "synchronizer") {
    return "The + ports agree, the − ports agree, and the two pairs are opposite";
  }
  if (constraint.name === "6-alternator") {
    return "Neighboring ports alternate inward and outward";
  }
  return constraint.name;
};

export function Visualizer() {
  let graphCanvas: SVGSVGElement | undefined;
  let activeEdgeDrag: {
    edgeId: string;
    pointerId: number;
    path: SVGPathElement;
    startFraction: number;
    startPoint: Point;
  } | null = null;
  let suppressedEdgeClick: { edgeId: string; expires: number } | null = null;
  const usesCommandKey = platformUsesCommandKey(detectedPlatform());
  const historyModifier = usesCommandKey ? "Command" : "Ctrl";
  const [theme, setTheme] = createSignal<Theme>(initialTheme());
  const [selectedId, setSelectedId] = createSignal(EXAMPLES[0].id);
  const selectedGraph = createMemo(() => EXAMPLES.find(({ id }) => id === selectedId()) ?? EXAMPLES[0]);
  const [directions, setDirections] = createSignal<DirectionState>(emptyDirections(selectedGraph()));
  const [undoStack, setUndoStack] = createSignal<DirectionState[]>([]);
  const [redoStack, setRedoStack] = createSignal<DirectionState[]>([]);
  const canUndo = createMemo(() => undoStack().length > 0);
  const canRedo = createMemo(() => redoStack().length > 0);
  const [hovered, setHovered] = createSignal<{ edge: string; zone: 0 | 1 | 2 } | null>(null);

  const vertexTypes = createMemo(() => {
    const grouped = new Map<string, { constraint: Constraint; labels: Set<string> }>();
    for (const vertex of selectedGraph().vertices) {
      const key = `${vertex.constraint.name}:${vertex.constraint.allowed.join(",")}`;
      const group = grouped.get(key) ?? { constraint: vertex.constraint, labels: new Set<string>() };
      if (vertex.label) group.labels.add(vertex.label);
      grouped.set(key, group);
    }
    return [...grouped.values()].map(({ constraint, labels }) => {
      const visibleLabels = [...labels];
      const symbol = visibleLabels.length === 0
        ? constraint.shortLabel
        : `${visibleLabels.slice(0, 2).join(", ")}${visibleLabels.length > 2 ? ", …" : ""}`;
      return { symbol, rule: constraintRule(constraint) };
    });
  });

  const analyses = createMemo(() => Object.fromEntries(
    selectedGraph().vertices.map((vertex) => [
      vertex.id,
      analyzeVertex(selectedGraph(), directions(), vertex),
    ]),
  ));

  const forcedEdges = createMemo(() => {
    const result: Record<string, { direction: 0 | 1 | null; conflict: boolean }> = {};
    for (const edge of selectedGraph().edges) {
      const implied = new Set<0 | 1>();
      for (const analysis of Object.values(analyses())) {
        const direction = analysis.forced.get(edge.id);
        if (direction !== undefined) implied.add(direction);
      }
      result[edge.id] = {
        direction: implied.size === 1 ? [...implied][0] : null,
        conflict: implied.size > 1,
      };
    }
    return result;
  });

  const progress = createMemo(() => {
    const values = Object.values(analyses());
    const oriented = Object.values(directions()).filter((direction) => direction !== null).length;
    const impossible = values.filter(({ state }) => state === "impossible").length;
    const satisfied = values.filter(({ state }) => state === "satisfied").length;
    const forced = values.filter(({ state }) => state === "forced").length;
    const edgeConflicts = Object.values(forcedEdges()).filter(({ conflict }) => conflict).length;
    const solved = oriented === selectedGraph().edges.length && satisfied === selectedGraph().vertices.length;
    return { oriented, impossible, satisfied, forced, edgeConflicts, solved };
  });

  const directionsEqual = (first: DirectionState, second: DirectionState) => {
    const keys = Object.keys(first);
    return keys.length === Object.keys(second).length && keys.every((key) => first[key] === second[key]);
  };

  const commitDirections = (update: DirectionUpdate) => {
    const current = directions();
    const next = typeof update === "function" ? update(current) : update;
    if (directionsEqual(current, next)) return;
    batch(() => {
      setUndoStack((stack) => [...stack, current]);
      setRedoStack([]);
      setDirections(next);
    });
  };

  const undo = () => {
    const stack = undoStack();
    const previous = stack[stack.length - 1];
    if (!previous) return;
    const current = directions();
    batch(() => {
      setUndoStack(stack.slice(0, -1));
      setRedoStack((redo) => [...redo, current]);
      setDirections(previous);
    });
  };

  const redo = () => {
    const stack = redoStack();
    const next = stack[stack.length - 1];
    if (!next) return;
    const current = directions();
    batch(() => {
      setRedoStack(stack.slice(0, -1));
      setUndoStack((undoHistory) => [...undoHistory, current]);
      setDirections(next);
    });
  };

  const chooseExample = (id: string) => {
    const graph = EXAMPLES.find((example) => example.id === id) ?? EXAMPLES[0];
    batch(() => {
      setSelectedId(graph.id);
      setDirections(emptyDirections(graph));
      setUndoStack([]);
      setRedoStack([]);
      setHovered(null);
    });
  };

  const setEdge = (edgeId: string, direction: EdgeDirection) => {
    commitDirections((current) => ({ ...current, [edgeId]: direction }));
  };

  const interactWithEdge = (event: MouseEvent, edge: Edge) => {
    const path = event.currentTarget as SVGPathElement;
    const fraction = closestFraction(path, eventPoint(event, path));
    setEdge(edge.id, fraction < 1 / 3 ? 0 : fraction > 2 / 3 ? 1 : null);
  };

  const clickEdge = (event: MouseEvent, edge: Edge) => {
    if (suppressedEdgeClick?.edgeId === edge.id && performance.now() <= suppressedEdgeClick.expires) {
      suppressedEdgeClick = null;
      return;
    }
    suppressedEdgeClick = null;
    interactWithEdge(event, edge);
  };

  const beginEdgeDrag = (event: PointerEvent, edge: Edge) => {
    if (event.button !== 0 || event.isPrimary === false) return;
    const path = event.currentTarget as SVGPathElement;
    activeEdgeDrag = {
      edgeId: edge.id,
      pointerId: event.pointerId,
      path,
      startFraction: closestFraction(path, eventPoint(event, path)),
      startPoint: { x: event.clientX, y: event.clientY },
    };
    try {
      path.setPointerCapture(event.pointerId);
    } catch {
      // Pointer capture is an enhancement; the gesture can still finish over the path.
    }
  };

  const finishEdgeDrag = (event: PointerEvent, edge: Edge) => {
    const drag = activeEdgeDrag;
    if (!drag || drag.edgeId !== edge.id || drag.pointerId !== event.pointerId) return;
    activeEdgeDrag = null;
    try {
      drag.path.releasePointerCapture(event.pointerId);
    } catch {
      // The browser may already have released capture.
    }
    const direction = edgeSwipeDirection(
      drag.startFraction,
      closestFraction(drag.path, eventPoint(event, drag.path)),
      drag.startPoint,
      { x: event.clientX, y: event.clientY },
    );
    if (direction === null) return;
    event.preventDefault();
    setEdge(edge.id, direction);
    suppressedEdgeClick = { edgeId: edge.id, expires: performance.now() + 750 };
  };

  const cancelEdgeDrag = (event: PointerEvent, edge: Edge) => {
    if (activeEdgeDrag?.edgeId === edge.id && activeEdgeDrag.pointerId === event.pointerId) {
      activeEdgeDrag = null;
    }
  };

  const trackEdge = (event: PointerEvent, edge: Edge) => {
    const path = event.currentTarget as SVGPathElement;
    const fraction = closestFraction(path, eventPoint(event, path));
    setHovered({ edge: edge.id, zone: fraction < 1 / 3 ? 0 : fraction > 2 / 3 ? 1 : 2 });
    if (activeEdgeDrag?.edgeId === edge.id && activeEdgeDrag.pointerId === event.pointerId) {
      event.preventDefault();
    }
  };

  const cycleEdge = (edge: Edge) => {
    const current = directions()[edge.id];
    setEdge(edge.id, current === null ? 1 : current === 1 ? 0 : null);
  };

  const applyForcedAt = (vertex: Vertex) => {
    const forced = analyses()[vertex.id].forced;
    if (forced.size === 0) return;
    commitDirections((current) => {
      const next = { ...current };
      forced.forEach((direction, edgeId) => { next[edgeId] = direction; });
      return next;
    });
  };

  const stateSummary = () => {
    const current = progress();
    if (current.solved) return { tone: "success", title: "Solved", text: "Every edge is oriented and every vertex is satisfied." };
    if (current.impossible > 0) return {
      tone: "danger",
      title: "Contradiction",
      text: `${current.impossible} ${current.impossible === 1 ? "vertex has" : "vertices have"} no possible completion.`,
    };
    if (current.edgeConflicts > 0) return {
      tone: "danger",
      title: "Forced conflict",
      text: "Two neighboring vertices require an unoriented edge in opposite directions.",
    };
    if (current.forced > 0) return {
      tone: "hint",
      title: `${current.forced} forced ${current.forced === 1 ? "vertex" : "vertices"}`,
      text: "Dashed arrows show deductions. Click a cyan vertex to apply its forced edges.",
    };
    return {
      tone: "neutral",
      title: "In progress",
      text: `${current.oriented} of ${selectedGraph().edges.length} edges oriented.`,
    };
  };

  const groups = ["Full graphs", "Paper gadgets"] as const;

  const handleHistoryKeyDown = (event: KeyboardEvent) => {
    if (event.defaultPrevented || event.altKey || (!event.ctrlKey && !event.metaKey)) return;
    const target = event.target;
    if (
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      (target instanceof HTMLElement && target.isContentEditable)
    ) return;
    const key = event.key.toLowerCase();
    const action = key === "z" ? (event.shiftKey ? redo : undo) : key === "y" ? redo : null;
    if (!action || (action === undo ? !canUndo() : !canRedo())) return;
    event.preventDefault();
    action();
  };

  window.addEventListener("keydown", handleHistoryKeyDown);
  onCleanup(() => window.removeEventListener("keydown", handleHistoryKeyDown));

  createEffect(() => {
    document.documentElement.dataset.theme = theme();
  });

  const toggleTheme = () => {
    const next = theme() === "dark" ? "light" : "dark";
    setTheme(next);
    try {
      window.localStorage.setItem(THEME_STORAGE_KEY, next);
    } catch {
      // The toggle still works for this page when storage is unavailable.
    }
  };

  const downloadSvg = () => {
    if (!graphCanvas) return;
    const blob = new Blob([serializeGraphSvg(graphCanvas, theme())], {
      type: "image/svg+xml;charset=utf-8",
    });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = `${selectedGraph().id}.svg`;
    link.hidden = true;
    document.body.append(link);
    link.click();
    link.remove();
    window.setTimeout(() => URL.revokeObjectURL(url), 0);
  };

  return (
    <div class="app-shell">
      <header class="masthead">
        <img class="brand-mark" src="./favicon.svg" alt="" aria-hidden="true" />
        <div class="brand-copy">
          <h1 aria-label="Graph Orientation Playground">
            <span class="title-small-caps" aria-hidden="true">
              <span><span class="title-initial">G</span>RAPH</span>{" "}
              <span><span class="title-initial">O</span>RIENTATION</span>{" "}
              <span><span class="title-initial">P</span>LAYGROUND</span>
            </span>
          </h1>
        </div>
        <div class="masthead-actions">
          <button
            class="theme-toggle"
            type="button"
            aria-label="Dark mode"
            aria-pressed={theme() === "dark"}
            title={`Switch to ${theme() === "dark" ? "light" : "dark"} mode`}
            onClick={toggleTheme}
          >
            <span class="theme-toggle__icon" aria-hidden="true">{theme() === "dark" ? "☾" : "☀"}</span>
          </button>
          <a class="masthead-link paper-link" href="https://arxiv.org/abs/2603.03488" target="_blank" rel="noreferrer">
            <span class="masthead-link__label">Paper</span>
            <span class="external-arrow" aria-hidden="true">↗</span>
          </a>
          <a
            class="masthead-link github-link"
            href="https://github.com/edemaine/graph-orientation-visualizer"
            target="_blank"
            rel="noreferrer"
          >
            <svg class="github-icon" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.65 7.65 0 0 1 8 6.32c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
            <span class="masthead-link__label">GitHub</span>
            <span class="external-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </header>

      <main class="workspace">
        <aside class="control-panel" aria-label="Visualizer controls">
          <section>
            <label class="field-label" for="example">Example</label>
            <div class="select-wrap">
              <select id="example" value={selectedId()} onChange={(event) => chooseExample(event.currentTarget.value)}>
                <For each={groups}>{(group) => (
                  <optgroup label={group}>
                    <For each={EXAMPLES.filter((example) => example.group === group)}>{(example) => (
                      <option value={example.id}>{example.title}</option>
                    )}</For>
                  </optgroup>
                )}</For>
              </select>
            </div>
            <p class="description">
              <For each={parseLabelMarkup(selectedGraph().description)}>{(part) => (
                part.italic ? <i>{part.text}</i> : part.text
              )}</For>
              <Show when={selectedGraph().source}>{(source) => (
                <a class="description-source" href={source().url} target="_blank" rel="noreferrer">
                  {source().label} <span aria-hidden="true">↗</span>
                </a>
              )}</Show>
            </p>
          </section>

          <div class="vertex-info">
            <section class="vertex-types">
              <h3>Vertex types</h3>
              <dl class="vertex-type-list" aria-label="Vertex types in this example">
                <For each={vertexTypes()}>{({ symbol, rule }) => (
                  <div class="vertex-type">
                    <dt class="vertex-type-symbol"><span>{symbol}</span></dt>
                    <dd>{rule}</dd>
                  </div>
                )}</For>
              </dl>
            </section>

            <section class="legend" aria-label="Vertex state legend">
              <div class="legend-grid">
                <span><i class="dot dot--open" />Open</span>
                <span><i class="dot dot--forced" />Forced</span>
                <span><i class="dot dot--satisfied" />Satisfied</span>
                <span><i class="dot dot--impossible" />Impossible</span>
              </div>
            </section>
          </div>

          <section class={`state-card state-card--${stateSummary().tone}`} aria-live="polite">
            <div class="state-card__icon" aria-hidden="true">
              {progress().solved ? "✓" : progress().impossible || progress().edgeConflicts ? "!" : progress().forced ? "↯" : "·"}
            </div>
            <div>
              <strong>{stateSummary().title}</strong>
              <p>{stateSummary().text}</p>
            </div>
          </section>

          <section class="how-to">
            <h3>How to play</h3>
            <ol>
              <li><span class="step-number">1</span><span>Click near an endpoint, or swipe along an edge, to orient it.</span></li>
              <li><span class="step-number">2</span><span>Click its middle third to remove the arrow.</span></li>
              <li><span class="step-number">3</span><span>Click a cyan vertex to apply its forced moves.</span></li>
            </ol>
          </section>

          <button class="reset-button" type="button" onClick={() => commitDirections(emptyDirections(selectedGraph()))}>
            <span aria-hidden="true">↺</span> Reset orientations
          </button>
        </aside>

        <section class="canvas-panel" aria-label={`${selectedGraph().title} graph`}>
          <div class={`graph-frame${progress().solved ? " graph-frame--solved" : ""}`}>
            <svg
              ref=graphCanvas!
              class="graph-canvas"
              viewBox={(selectedGraph().viewBox ?? [0, 0, 800, 560]).join(" ")}
              role="img"
              aria-label={`Interactive graph: ${selectedGraph().title}`}
            >
              <defs>
                <!-- Arrowhead geometry from Cocreate's client/DrawApp.coffee:
                    https://github.com/edemaine/cocreate/blob/main/client/DrawApp.coffee -->
                <marker id="arrow" viewBox="0 0 10 10" refX="9.5" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse" overflow="visible">
                  <path d="M 0 -1 L 10 3.854 A 1.252 1.252 0 0 1 10 6.146 L 0 11 z" />
                </marker>
                <marker id="ghost-arrow" viewBox="0 0 10 10" refX="9.5" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse" overflow="visible">
                  <path d="M 0 -1 L 10 3.854 A 1.252 1.252 0 0 1 10 6.146 L 0 11 z" />
                </marker>
                <filter id="success-glow" x="-50%" y="-50%" width="200%" height="200%">
                  <feGaussianBlur stdDeviation="5" result="blur" />
                  <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
                </filter>
              </defs>

              <g class="edge-layer">
                <For each={selectedGraph().edges}>{(edge) => {
                  const geometry = () => { return edgeGeometry(selectedGraph(), edge); };
                  const direction = () => { return directions()[edge.id] ?? null; };
                  const forced = () => { return forcedEdges()[edge.id] ?? { direction: null, conflict: false }; };
                  const hover = () => { return hovered()?.edge === edge.id ? hovered()?.zone : undefined; };
                  return (
                    <g class={`edge-group${forced().conflict ? " edge-group--conflict" : ""}`}>
                      <g class="edge-visual">
                        <path class="edge-base" d={geometry().forward} />
                        <Show when={direction() !== null}>
                          <path
                            class="edge-oriented"
                            d={direction() === 1 ? geometry().forward : geometry().reverse}
                            marker-end="url(#arrow)"
                          />
                        </Show>
                        <Show when={direction() === null && forced().direction !== null}>
                          <path
                            class="edge-forced"
                            d={forced().direction === 1 ? geometry().forward : geometry().reverse}
                            marker-end="url(#ghost-arrow)"
                          />
                        </Show>
                        <Show when={forced().conflict}>
                          <path class="edge-conflict" d={geometry().forward} />
                        </Show>
                      </g>
                      <Show when={hover() !== undefined}>
                        <circle
                          class={`edge-hover edge-hover--${hover()}`}
                          cx={hover() === 0 ? geometry().start.x : hover() === 1 ? geometry().end.x : geometry().midpoint.x}
                          cy={hover() === 0 ? geometry().start.y : hover() === 1 ? geometry().end.y : geometry().midpoint.y}
                          r="8"
                        />
                      </Show>
                      <path
                        class="edge-hit"
                        d={geometry().forward}
                        tabindex="0"
                        role="button"
                        aria-label={`${edge.id}: ${direction() === null ? "unoriented" : directionLabel(edge, direction() as 0 | 1)}. Swipe or drag along the edge to orient it; Enter cycles direction; Delete clears.`}
                        onClick={(event) => clickEdge(event, edge)}
                        onPointerDown={(event) => beginEdgeDrag(event, edge)}
                        onPointerMove={(event) => trackEdge(event, edge)}
                        onPointerUp={(event) => finishEdgeDrag(event, edge)}
                        onPointerCancel={(event) => cancelEdgeDrag(event, edge)}
                        onPointerLeave={() => setHovered(null)}
                        onKeyDown={(event) => {
                          if (event.key === "Enter" || event.key === " ") {
                            event.preventDefault();
                            cycleEdge(edge);
                          } else if (event.key === "Delete" || event.key === "Backspace") {
                            event.preventDefault();
                            setEdge(edge.id, null);
                          }
                        }}
                      />
                      <For each={edge.ends}>{(end) => (
                        <Show when={!('vertex' in end)}>
                          <circle class="external-port" cx={(end as { x: number; y: number }).x} cy={(end as { x: number; y: number }).y} r="5" />
                        </Show>
                      )}</For>
                    </g>
                  );
                }}</For>
              </g>

              <g class="vertex-layer">
                <For each={selectedGraph().vertices}>{(vertex) => {
                  const analysis = () => { return analyses()[vertex.id] ?? {
                    state: "open" as const,
                    compatible: [],
                    forced: new Map<string, 0 | 1>(),
                    assignedPorts: 0,
                    totalPorts: 0,
                  }; };
                  const clickable = () => { return analysis().state === "forced"; };
                  const vertexName = () => {
                    const name = vertex.annotation?.text ?? vertex.label;
                    return name === undefined ? undefined : plainLabel(name);
                  };
                  const interiorLabel = () => { return vertex.label ?? vertex.constraint.shortLabel; };
                  const annotation = () => {
                    if (!vertex.annotation) return null;
                    const corner = vertex.annotation.corner ?? "top-right";
                    const right = corner.endsWith("right");
                    const bottom = corner.startsWith("bottom");
                    return {
                      ...vertex.annotation,
                      x: (right ? 1 : -1) * (NODE_RADIUS + 4),
                      y: (bottom ? 1 : -1) * (NODE_RADIUS + 4),
                      anchor: (right ? "start" : "end") as "start" | "end",
                    };
                  };
                  const portLabels = () => {
                    const groups = vertex.constraint.portGroups;
                    if (!groups) return [];
                    return incidencesAt(selectedGraph(), vertex.id).map((incidence) => {
                      const geometry = edgeGeometry(selectedGraph(), incidence.edge);
                      const endpoint = incidence.endIndex === 0 ? geometry.start : geometry.end;
                      const direction = unit({ x: endpoint.x - vertex.x, y: endpoint.y - vertex.y });
                      const radius = NODE_RADIUS - 8;
                      const group = groups[incidence.port];
                      return {
                        group,
                        label: group === 0 ? "+" : "−",
                        x: direction.x * radius,
                        y: direction.y * radius,
                      };
                    });
                  };
                  return (
                    <g
                      class={`vertex vertex--${analysis().state}${clickable() ? " vertex--clickable" : ""}`}
                      transform={`translate(${vertex.x} ${vertex.y})`}
                      role={clickable() ? "button" : undefined}
                      tabindex={clickable() ? 0 : -1}
                      aria-label={`${vertexName() ? `${vertexName()}, ` : ""}${vertex.constraint.name} vertex: ${analysis().state}. ${analysis().compatible.length} compatible local completions.`}
                      onClick={() => applyForcedAt(vertex)}
                      onKeyDown={(event) => {
                        if (clickable() && (event.key === "Enter" || event.key === " ")) {
                          event.preventDefault();
                          applyForcedAt(vertex);
                        }
                      }}
                    >
                      <title>{vertexName() ? `${vertexName()}: ` : ""}{vertex.constraint.name}, {analysis().state}</title>
                      <circle class="vertex-halo" r="36" />
                      <g class="vertex-shape">
                        <circle class="vertex-body" r={NODE_RADIUS} />
                      </g>
                      <text
                        class={`vertex-label${[...interiorLabel()].length === 1 ? " vertex-label--single-character" : ""}`}
                        text-anchor="middle"
                        dominant-baseline="central"
                      >{interiorLabel()}</text>
                      <Show when={annotation()}>{(visibleAnnotation) => (
                        <text
                          class="vertex-annotation"
                          x={visibleAnnotation().x}
                          y={visibleAnnotation().y}
                          text-anchor={visibleAnnotation().anchor}
                          dominant-baseline="central"
                          aria-hidden="true"
                        >
                          <For each={parseLabelMarkup(visibleAnnotation().text)}>{(part) => (
                            <tspan font-style={part.italic ? "italic" : "normal"}>{part.text}</tspan>
                          )}</For>
                        </text>
                      )}</Show>
                      <For each={portLabels()}>{(label) => (
                        <text
                          class={`port-pair-label port-pair-label--${label.group}`}
                          x={label.x}
                          y={label.y}
                          text-anchor="middle"
                          dominant-baseline="central"
                          aria-hidden="true"
                        >{label.label}</text>
                      )}</For>
                      <Show when={analysis().state === "satisfied"}>
                        <g class="vertex-badge"><circle cx="23" cy="-23" r="10" /><text x="23" y="-22" text-anchor="middle" dominant-baseline="central">✓</text></g>
                      </Show>
                      <Show when={analysis().state === "impossible"}>
                        <g class="vertex-badge"><circle cx="23" cy="-23" r="10" /><text x="23" y="-22" text-anchor="middle" dominant-baseline="central">!</text></g>
                      </Show>
                    </g>
                  );
                }}</For>
              </g>
            </svg>
            <Show when={progress().solved}>
              <div class="victory-toast" role="status"><span>✓</span> Orientation complete</div>
            </Show>
          </div>
          <div class="canvas-footer">
            <div class="canvas-history">
              <span class="counter"><strong>{progress().oriented}</strong> / {selectedGraph().edges.length} edges</span>
              <div class="history-controls" role="group" aria-label="Orientation history">
                <button
                  class="history-button"
                  type="button"
                  disabled={!canUndo()}
                  aria-label="Undo orientation change"
                  title={`Undo (${historyModifier} + Z)`}
                  onClick={undo}
                >
                  <span aria-hidden="true">↶</span><span class="history-button__label">Undo</span>
                </button>
                <button
                  class="history-button"
                  type="button"
                  disabled={!canRedo()}
                  aria-label="Redo orientation change"
                  title={usesCommandKey
                    ? "Redo (Command + Shift + Z)"
                    : "Redo (Ctrl + Y)"}
                  onClick={redo}
                >
                  <span aria-hidden="true">↷</span><span class="history-button__label">Redo</span>
                </button>
              </div>
            </div>
            <p class="keyboard-note">
              Keyboard: <kbd>Enter</kbd> cycles, <kbd>Delete</kbd> clears, {" "}
              <Show
                when={usesCommandKey}
                fallback={<span><kbd>Ctrl</kbd>+<kbd>Z</kbd> undo, <kbd>Ctrl</kbd>+<kbd>Y</kbd> redo.</span>}
              >
                <span><kbd>Command</kbd>+<kbd>Z</kbd> undo, <kbd>Command</kbd>+<kbd>Shift</kbd>+<kbd>Z</kbd> redo.</span>
              </Show>
            </p>
            <button class="download-button" type="button" onClick={downloadSvg}>
              <span aria-hidden="true">↓</span> Download SVG
            </button>
          </div>
        </section>
      </main>
    </div>
  );
}
