import { For, Show, batch, createMemo, createSignal } from "solid-js";
import { EXAMPLES } from "./examples.civet";
import {
  type Constraint,
  type Edge,
  type EdgeDirection,
  type EdgeEnd,
  type GraphDefinition,
  type Vertex,
  analyzeVertex,
  emptyDirections,
  incidencesAt,
} from "./model.civet";

const NODE_RADIUS = 29;
const NODE_EDGE_PADDING = NODE_RADIUS + 4;
const EXTERNAL_EDGE_PADDING = 7;

interface Point { x: number; y: number }

const endpointPoint = (graph: GraphDefinition, end: EdgeEnd): Point => {
  if ("vertex" in end) {
    const vertex = graph.vertices.find(({ id }) => id === end.vertex);
    if (!vertex) throw new Error(`Missing vertex ${end.vertex}`);
    return { x: vertex.x, y: vertex.y };
  }
  return end;
};

const unit = (point: Point): Point => {
  const length = Math.hypot(point.x, point.y) || 1;
  return { x: point.x / length, y: point.y / length };
};

const edgeGeometry = (graph: GraphDefinition, edge: Edge) => {
  const rawStart = endpointPoint(graph, edge.ends[0]);
  const rawEnd = endpointPoint(graph, edge.ends[1]);
  const firstWaypoint = edge.route?.[0];
  const lastWaypoint = edge.route?.[edge.route.length - 1];
  const startDirection = edge.control
    ? unit({ x: edge.control.x - rawStart.x, y: edge.control.y - rawStart.y })
    : unit({
        x: (firstWaypoint ?? rawEnd).x - rawStart.x,
        y: (firstWaypoint ?? rawEnd).y - rawStart.y,
      });
  const endDirection = edge.control
    ? unit({ x: rawEnd.x - edge.control.x, y: rawEnd.y - edge.control.y })
    : unit({
        x: rawEnd.x - (lastWaypoint ?? rawStart).x,
        y: rawEnd.y - (lastWaypoint ?? rawStart).y,
      });
  const startPadding = "vertex" in edge.ends[0] ? NODE_EDGE_PADDING : EXTERNAL_EDGE_PADDING;
  const endPadding = "vertex" in edge.ends[1] ? NODE_EDGE_PADDING : EXTERNAL_EDGE_PADDING;
  const start = {
    x: rawStart.x + startDirection.x * startPadding,
    y: rawStart.y + startDirection.y * startPadding,
  };
  const end = {
    x: rawEnd.x - endDirection.x * endPadding,
    y: rawEnd.y - endDirection.y * endPadding,
  };
  if (edge.control) {
    const middle = ` Q ${edge.control.x} ${edge.control.y}`;
    const forward = `M ${start.x} ${start.y}${middle} ${end.x} ${end.y}`;
    const reverse = `M ${end.x} ${end.y}${middle} ${start.x} ${start.y}`;
    const midpoint = {
      x: 0.25 * start.x + 0.5 * edge.control.x + 0.25 * end.x,
      y: 0.25 * start.y + 0.5 * edge.control.y + 0.25 * end.y,
    };
    return { start, end, midpoint, forward, reverse };
  }

  const points = [start, ...(edge.route ?? []), end];
  const path = (pathPoints: Point[]) => {
    return `M ${pathPoints.map(({ x, y }) => `${x} ${y}`).join(" L ")}`;
  };
  const lengths = points.slice(1).map((point, index) => {
    return Math.hypot(point.x - points[index].x, point.y - points[index].y);
  });
  const halfway = lengths.reduce((sum, length) => sum + length, 0) / 2;
  let traversed = 0;
  let midpoint = { ...start };
  for (let index = 0; index < lengths.length; index += 1) {
    const length = lengths[index];
    if (traversed + length >= halfway) {
      const fraction = length === 0 ? 0 : (halfway - traversed) / length;
      midpoint = {
        x: points[index].x + fraction * (points[index + 1].x - points[index].x),
        y: points[index].y + fraction * (points[index + 1].y - points[index].y),
      };
      break;
    }
    traversed += length;
  }
  const forward = path(points);
  const reverse = path([...points].reverse());
  return { start, end, midpoint, forward, reverse };
};

const eventPoint = (event: MouseEvent | PointerEvent, path: SVGPathElement): Point => {
  const svg = path.ownerSVGElement;
  const matrix = svg?.getScreenCTM();
  if (!svg || !matrix) return { x: 0, y: 0 };
  const point = svg.createSVGPoint();
  point.x = event.clientX;
  point.y = event.clientY;
  const local = point.matrixTransform(matrix.inverse());
  return { x: local.x, y: local.y };
};

const closestFraction = (path: SVGPathElement, point: Point): number => {
  const length = path.getTotalLength();
  let bestFraction = 0;
  let bestDistance = Number.POSITIVE_INFINITY;
  for (let step = 0; step <= 60; step += 1) {
    const fraction = step / 60;
    const sample = path.getPointAtLength(length * fraction);
    const distance = (sample.x - point.x) ** 2 + (sample.y - point.y) ** 2;
    if (distance < bestDistance) {
      bestDistance = distance;
      bestFraction = fraction;
    }
  }
  return bestFraction;
};

const directionLabel = (edge: Edge, direction: 0 | 1): string => {
  const end = edge.ends[direction];
  return "vertex" in end ? `toward ${end.vertex}` : "toward the dangling end";
};

const constraintRule = (constraint: Constraint): string => {
  const exact = /^(\d+)-in-(\d+)$/.exec(constraint.name);
  if (exact) return `Exactly ${exact[1]} of ${exact[2]} edges point inward`;
  if (constraint.name === `{0,${constraint.degree}}-in-${constraint.degree}`) {
    return "All edges point inward or all point outward";
  }
  if (constraint.name === "synchronizer") {
    return "The + ports agree, the − ports agree, and the two pairs are opposite";
  }
  if (constraint.name === "6-alternator") {
    return "Neighboring ports alternate inward and outward";
  }
  return constraint.name;
};

export function Visualizer() {
  const [selectedId, setSelectedId] = createSignal(EXAMPLES[0].id);
  const selectedGraph = createMemo(() => EXAMPLES.find(({ id }) => id === selectedId()) ?? EXAMPLES[0]);
  const [directions, setDirections] = createSignal<Record<string, EdgeDirection>>(emptyDirections(selectedGraph()));
  const [hovered, setHovered] = createSignal<{ edge: string; zone: 0 | 1 | 2 } | null>(null);

  const vertexTypes = createMemo(() => {
    const grouped = new Map<string, { constraint: Constraint; labels: Set<string> }>();
    for (const vertex of selectedGraph().vertices) {
      const key = `${vertex.constraint.name}:${vertex.constraint.allowed.join(",")}`;
      const group = grouped.get(key) ?? { constraint: vertex.constraint, labels: new Set<string>() };
      if (vertex.label) group.labels.add(vertex.label);
      grouped.set(key, group);
    }
    return [...grouped.values()].map(({ constraint, labels }) => {
      const visibleLabels = [...labels];
      const symbol = visibleLabels.length === 0
        ? constraint.shortLabel
        : `${visibleLabels.slice(0, 2).join(", ")}${visibleLabels.length > 2 ? ", …" : ""}`;
      return { symbol, rule: constraintRule(constraint) };
    });
  });

  const analyses = createMemo(() => Object.fromEntries(
    selectedGraph().vertices.map((vertex) => [
      vertex.id,
      analyzeVertex(selectedGraph(), directions(), vertex),
    ]),
  ));

  const forcedEdges = createMemo(() => {
    const result: Record<string, { direction: 0 | 1 | null; conflict: boolean }> = {};
    for (const edge of selectedGraph().edges) {
      const implied = new Set<0 | 1>();
      for (const analysis of Object.values(analyses())) {
        const direction = analysis.forced.get(edge.id);
        if (direction !== undefined) implied.add(direction);
      }
      result[edge.id] = {
        direction: implied.size === 1 ? [...implied][0] : null,
        conflict: implied.size > 1,
      };
    }
    return result;
  });

  const progress = createMemo(() => {
    const values = Object.values(analyses());
    const oriented = Object.values(directions()).filter((direction) => direction !== null).length;
    const impossible = values.filter(({ state }) => state === "impossible").length;
    const satisfied = values.filter(({ state }) => state === "satisfied").length;
    const forced = values.filter(({ state }) => state === "forced").length;
    const edgeConflicts = Object.values(forcedEdges()).filter(({ conflict }) => conflict).length;
    const solved = oriented === selectedGraph().edges.length && satisfied === selectedGraph().vertices.length;
    return { oriented, impossible, satisfied, forced, edgeConflicts, solved };
  });

  const chooseExample = (id: string) => {
    const graph = EXAMPLES.find((example) => example.id === id) ?? EXAMPLES[0];
    batch(() => {
      setSelectedId(graph.id);
      setDirections(emptyDirections(graph));
      setHovered(null);
    });
  };

  const setEdge = (edgeId: string, direction: EdgeDirection) => {
    setDirections((current) => ({ ...current, [edgeId]: direction }));
  };

  const interactWithEdge = (event: MouseEvent, edge: Edge) => {
    const path = event.currentTarget as SVGPathElement;
    const fraction = closestFraction(path, eventPoint(event, path));
    setEdge(edge.id, fraction < 1 / 3 ? 0 : fraction > 2 / 3 ? 1 : null);
  };

  const trackEdge = (event: PointerEvent, edge: Edge) => {
    const path = event.currentTarget as SVGPathElement;
    const fraction = closestFraction(path, eventPoint(event, path));
    setHovered({ edge: edge.id, zone: fraction < 1 / 3 ? 0 : fraction > 2 / 3 ? 1 : 2 });
  };

  const cycleEdge = (edge: Edge) => {
    const current = directions()[edge.id];
    setEdge(edge.id, current === null ? 1 : current === 1 ? 0 : null);
  };

  const applyForcedAt = (vertex: Vertex) => {
    const forced = analyses()[vertex.id].forced;
    if (forced.size === 0) return;
    setDirections((current) => {
      const next = { ...current };
      forced.forEach((direction, edgeId) => { next[edgeId] = direction; });
      return next;
    });
  };

  const stateSummary = () => {
    const current = progress();
    if (current.solved) return { tone: "success", title: "Solved", text: "Every edge is oriented and every vertex is satisfied." };
    if (current.impossible > 0) return {
      tone: "danger",
      title: "Contradiction",
      text: `${current.impossible} ${current.impossible === 1 ? "vertex has" : "vertices have"} no possible completion.`,
    };
    if (current.edgeConflicts > 0) return {
      tone: "danger",
      title: "Forced conflict",
      text: "Two neighboring vertices require an unoriented edge in opposite directions.",
    };
    if (current.forced > 0) return {
      tone: "hint",
      title: `${current.forced} forced ${current.forced === 1 ? "vertex" : "vertices"}`,
      text: "Dashed arrows show deductions. Click a cyan vertex to apply its forced edges.",
    };
    return {
      tone: "neutral",
      title: "In progress",
      text: `${current.oriented} of ${selectedGraph().edges.length} edges oriented.`,
    };
  };

  const groups = ["Learn", "Full graphs", "Paper gadgets"] as const;

  return (
    <div class="app-shell">
      <header class="masthead">
        <div class="brand-mark" aria-hidden="true"><span>↗</span><span>↙</span></div>
        <div class="brand-copy">
          <p class="eyebrow">Interactive constraint lab</p>
          <h1>Graph Orientation Playground</h1>
        </div>
        <a class="paper-link" href="https://arxiv.org/abs/2603.03488" target="_blank" rel="noreferrer">
          Read the paper <span aria-hidden="true">↗</span>
        </a>
      </header>

      <main class="workspace">
        <aside class="control-panel" aria-label="Visualizer controls">
          <section>
            <label class="field-label" for="example">Example</label>
            <div class="select-wrap">
              <select id="example" value={selectedId()} onChange={(event) => chooseExample(event.currentTarget.value)}>
                <For each={groups}>{(group) => (
                  <optgroup label={group}>
                    <For each={EXAMPLES.filter((example) => example.group === group)}>{(example) => (
                      <option value={example.id}>{example.title}</option>
                    )}</For>
                  </optgroup>
                )}</For>
              </select>
            </div>
            <h2>{selectedGraph().title}</h2>
            <p class="description">{selectedGraph().description}</p>
          </section>

          <section class={`state-card state-card--${stateSummary().tone}`} aria-live="polite">
            <div class="state-card__icon" aria-hidden="true">
              {progress().solved ? "✓" : progress().impossible || progress().edgeConflicts ? "!" : progress().forced ? "↯" : "·"}
            </div>
            <div>
              <strong>{stateSummary().title}</strong>
              <p>{stateSummary().text}</p>
            </div>
          </section>

          <section class="vertex-types">
            <h3>Vertex types</h3>
            <table aria-label="Vertex types in this example">
              <thead><tr><th scope="col">Shown</th><th scope="col">Rule</th></tr></thead>
              <tbody>
                <For each={vertexTypes()}>{({ symbol, rule }) => (
                  <tr><td class="vertex-type-symbol">{symbol}</td><td>{rule}</td></tr>
                )}</For>
              </tbody>
            </table>
          </section>

          <section class="how-to">
            <h3>How to play</h3>
            <ol>
              <li><span class="step-number">1</span><span>Click an edge near an endpoint to point it there.</span></li>
              <li><span class="step-number">2</span><span>Click its middle third to remove the arrow.</span></li>
              <li><span class="step-number">3</span><span>Click a cyan vertex to apply its forced moves.</span></li>
            </ol>
          </section>

          <section class="legend" aria-label="Vertex state legend">
            <h3>Vertex feedback</h3>
            <div class="legend-grid">
              <span><i class="dot dot--open" />Open</span>
              <span><i class="dot dot--forced" />Forced</span>
              <span><i class="dot dot--satisfied" />Satisfied</span>
              <span><i class="dot dot--impossible" />Impossible</span>
            </div>
          </section>

          <button class="reset-button" type="button" onClick={() => setDirections(emptyDirections(selectedGraph()))}>
            <span aria-hidden="true">↺</span> Reset orientations
          </button>
        </aside>

        <section class="canvas-panel" aria-label={`${selectedGraph().title} graph`}>
          <div class="canvas-toolbar">
            <span class="counter"><strong>{progress().oriented}</strong> / {selectedGraph().edges.length} edges</span>
          </div>
          <div class={`graph-frame${progress().solved ? " graph-frame--solved" : ""}`}>
            <svg
              class="graph-canvas"
              viewBox={(selectedGraph().viewBox ?? [0, 0, 800, 560]).join(" ")}
              role="img"
              aria-label={`Interactive graph: ${selectedGraph().title}`}
            >
              <defs>
                <!-- Arrowhead geometry from Cocreate's client/DrawApp.coffee:
                    https://github.com/edemaine/cocreate/blob/main/client/DrawApp.coffee -->
                <marker id="arrow" viewBox="0 0 10 10" refX="9.5" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse" overflow="visible">
                  <path d="M 0 -1 L 10 3.854 A 1.252 1.252 0 0 1 10 6.146 L 0 11 z" />
                </marker>
                <marker id="ghost-arrow" viewBox="0 0 10 10" refX="9.5" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse" overflow="visible">
                  <path d="M 0 -1 L 10 3.854 A 1.252 1.252 0 0 1 10 6.146 L 0 11 z" />
                </marker>
                <filter id="success-glow" x="-50%" y="-50%" width="200%" height="200%">
                  <feGaussianBlur stdDeviation="5" result="blur" />
                  <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
                </filter>
              </defs>

              <g class="edge-layer">
                <For each={selectedGraph().edges}>{(edge) => {
                  const geometry = () => { return edgeGeometry(selectedGraph(), edge); };
                  const direction = () => { return directions()[edge.id] ?? null; };
                  const forced = () => { return forcedEdges()[edge.id] ?? { direction: null, conflict: false }; };
                  const hover = () => { return hovered()?.edge === edge.id ? hovered()?.zone : undefined; };
                  return (
                    <g class={`edge-group${forced().conflict ? " edge-group--conflict" : ""}`}>
                      <g class="edge-visual">
                        <path class="edge-base" d={geometry().forward} />
                        <Show when={direction() !== null}>
                          <path
                            class="edge-oriented"
                            d={direction() === 1 ? geometry().forward : geometry().reverse}
                            marker-end="url(#arrow)"
                          />
                        </Show>
                        <Show when={direction() === null && forced().direction !== null}>
                          <path
                            class="edge-forced"
                            d={forced().direction === 1 ? geometry().forward : geometry().reverse}
                            marker-end="url(#ghost-arrow)"
                          />
                        </Show>
                      </g>
                      <Show when={hover() !== undefined}>
                        <circle
                          class={`edge-hover edge-hover--${hover()}`}
                          cx={hover() === 0 ? geometry().start.x : hover() === 1 ? geometry().end.x : geometry().midpoint.x}
                          cy={hover() === 0 ? geometry().start.y : hover() === 1 ? geometry().end.y : geometry().midpoint.y}
                          r="8"
                        />
                      </Show>
                      <path
                        class="edge-hit"
                        d={geometry().forward}
                        tabindex="0"
                        role="button"
                        aria-label={`${edge.id}: ${direction() === null ? "unoriented" : directionLabel(edge, direction() as 0 | 1)}. Enter cycles direction; Delete clears.`}
                        onClick={(event) => interactWithEdge(event, edge)}
                        onPointerMove={(event) => trackEdge(event, edge)}
                        onPointerLeave={() => setHovered(null)}
                        onKeyDown={(event) => {
                          if (event.key === "Enter" || event.key === " ") {
                            event.preventDefault();
                            cycleEdge(edge);
                          } else if (event.key === "Delete" || event.key === "Backspace") {
                            event.preventDefault();
                            setEdge(edge.id, null);
                          }
                        }}
                      />
                      <For each={edge.ends}>{(end) => (
                        <Show when={!('vertex' in end)}>
                          <circle class="external-port" cx={(end as { x: number; y: number }).x} cy={(end as { x: number; y: number }).y} r="5" />
                        </Show>
                      )}</For>
                    </g>
                  );
                }}</For>
              </g>

              <g class="vertex-layer">
                <For each={selectedGraph().vertices}>{(vertex) => {
                  const analysis = () => { return analyses()[vertex.id] ?? {
                    state: "open" as const,
                    compatible: [],
                    forced: new Map<string, 0 | 1>(),
                    assignedPorts: 0,
                    totalPorts: 0,
                  }; };
                  const clickable = () => { return analysis().state === "forced"; };
                  const portLabels = () => {
                    const groups = vertex.constraint.portGroups;
                    if (!groups) return [];
                    return incidencesAt(selectedGraph(), vertex.id).map((incidence) => {
                      const geometry = edgeGeometry(selectedGraph(), incidence.edge);
                      const endpoint = incidence.endIndex === 0 ? geometry.start : geometry.end;
                      const direction = unit({ x: endpoint.x - vertex.x, y: endpoint.y - vertex.y });
                      const radius = NODE_RADIUS - 8;
                      const group = groups[incidence.port];
                      return {
                        group,
                        label: group === 0 ? "+" : "−",
                        x: direction.x * radius,
                        y: direction.y * radius,
                      };
                    });
                  };
                  return (
                    <g
                      class={`vertex vertex--${analysis().state}${clickable() ? " vertex--clickable" : ""}`}
                      transform={`translate(${vertex.x} ${vertex.y})`}
                      role={clickable() ? "button" : undefined}
                      tabindex={clickable() ? 0 : -1}
                      aria-label={`${vertex.label ? `${vertex.label}, ` : ""}${vertex.constraint.name} vertex: ${analysis().state}. ${analysis().compatible.length} compatible local completions.`}
                      onClick={() => applyForcedAt(vertex)}
                      onKeyDown={(event) => {
                        if (clickable() && (event.key === "Enter" || event.key === " ")) {
                          event.preventDefault();
                          applyForcedAt(vertex);
                        }
                      }}
                    >
                      <title>{vertex.label ? `${vertex.label}: ` : ""}{vertex.constraint.name}, {analysis().state}</title>
                      <circle class="vertex-halo" r="36" />
                      <g class="vertex-shape">
                        <circle class="vertex-body" r={NODE_RADIUS} display={vertex.shape === "square" ? "none" : undefined} />
                        <rect class="vertex-body" x={-NODE_RADIUS} y={-NODE_RADIUS} width={2 * NODE_RADIUS} height={2 * NODE_RADIUS} rx="5" display={vertex.shape === "square" ? undefined : "none"} />
                      </g>
                      <text class="vertex-label" text-anchor="middle" dominant-baseline="central">{vertex.label ?? vertex.constraint.shortLabel}</text>
                      <For each={portLabels()}>{(label) => (
                        <text
                          class={`port-pair-label port-pair-label--${label.group}`}
                          x={label.x}
                          y={label.y}
                          text-anchor="middle"
                          dominant-baseline="central"
                          aria-hidden="true"
                        >{label.label}</text>
                      )}</For>
                      <Show when={analysis().state === "satisfied"}>
                        <g class="vertex-badge"><circle cx="23" cy="-23" r="10" /><text x="23" y="-22" text-anchor="middle" dominant-baseline="central">✓</text></g>
                      </Show>
                      <Show when={analysis().state === "impossible"}>
                        <g class="vertex-badge"><circle cx="23" cy="-23" r="10" /><text x="23" y="-22" text-anchor="middle" dominant-baseline="central">!</text></g>
                      </Show>
                    </g>
                  );
                }}</For>
              </g>
            </svg>
            <Show when={progress().solved}>
              <div class="victory-toast" role="status"><span>✓</span> Orientation complete</div>
            </Show>
          </div>
          <p class="keyboard-note">Keyboard: focus an edge and press <kbd>Enter</kbd> to cycle it, or <kbd>Delete</kbd> to clear it.</p>
        </section>
      </main>
    </div>
  );
}
