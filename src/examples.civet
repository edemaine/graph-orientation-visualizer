import {
  type Edge,
  type EdgeEnd,
  type GraphDefinition,
  type Vertex,
  relationConstraint,
  symmetricConstraint,
  validateGraph,
} from "./model.civet";

const oneIn2 = symmetricConstraint(2, [1], "1∕2");
const oneIn3 = symmetricConstraint(3, [1], "1∕3");
const twoIn3 = symmetricConstraint(3, [2], "2∕3");
const twoIn4 = symmetricConstraint(4, [2], "2∕4");
const equalizer3 = symmetricConstraint(3, [0, 3], "=");
const equalizer4 = symmetricConstraint(4, [0, 4], "=");
const synchronizer = relationConstraint(4, ["1100", "0011"], "synchronizer", "S", [0, 0, 1, 1]);
const alternator6 = relationConstraint(6, ["101010", "010101"], "6-alternator", "A");

const vertex = (
  id: string,
  x: number,
  y: number,
  constraint: Vertex["constraint"],
  options: Pick<Vertex, "label" | "annotation"> = {},
): Vertex => {
  return { id, x, y, constraint, ...options };
};
const port = (vertexId: string, portNumber: number): EdgeEnd => {
  return { vertex: vertexId, port: portNumber };
};
const free = (x: number, y: number): EdgeEnd => { return { x, y }; };
const edge = (
  id: string,
  a: EdgeEnd,
  b: EdgeEnd,
  control?: Edge["control"],
): Edge => { return { id, ends: [a, b], control }; };
const routedEdge = (
  id: string,
  a: EdgeEnd,
  b: EdgeEnd,
  route: NonNullable<Edge["route"]>,
): Edge => { return { id, ends: [a, b], route }; };

const FIGURE_4_GRID_SIZE = 80;
const figure4Point = (column: number, row: number) => {
  return {
    x: 70 + FIGURE_4_GRID_SIZE * column,
    y: 1020 - FIGURE_4_GRID_SIZE * row,
  };
};
const figure4Route = (...points: [number, number][]) => {
  return points.map(([column, row]) => figure4Point(column, row));
};
const figure4Vertex = (
  id: string,
  column: number,
  row: number,
  constraint: Vertex["constraint"],
  options: Pick<Vertex, "label" | "annotation"> = {},
) => {
  const { x, y } = figure4Point(column, row);
  return vertex(id, x, y, constraint, options);
};

