import { describe, expect, it } from "vitest";
import {
  analyzeVertex,
  emptyDirections,
  relationConstraint,
  symmetricConstraint,
  type GraphDefinition,
} from "../src/model.civet";
import { EXAMPLES } from "../src/examples.civet";

const star: GraphDefinition = {
  id: "star",
  group: "Full graphs",
  title: "Star",
  description: "",
  vertices: [{ id: "v", x: 0, y: 0, constraint: symmetricConstraint(3, [1]) }],
  edges: [0, 1, 2].map((port) => ({
    id: `e${port}`,
    ends: [{ vertex: "v", port }, { x: 100 + port, y: 0 }],
  })),
};

describe("partial vertex analysis", () => {
  it("starts viable and unforced", () => {
    const analysis = analyzeVertex(star, emptyDirections(star), star.vertices[0]);
    expect(analysis.state).toBe("open");
    expect(analysis.compatible).toHaveLength(3);
  });

  it("finds forced edges after one incoming edge", () => {
    const analysis = analyzeVertex(star, { e0: 0, e1: null, e2: null }, star.vertices[0]);
    expect(analysis.state).toBe("forced");
    expect(analysis.forced.get("e1")).toBe(1);
    expect(analysis.forced.get("e2")).toBe(1);
  });

  it("reports a local contradiction", () => {
    const analysis = analyzeVertex(star, { e0: 0, e1: 0, e2: null }, star.vertices[0]);
    expect(analysis.state).toBe("impossible");
    expect(analysis.compatible).toHaveLength(0);
  });

  it("supports ordered asymmetric relations", () => {
    const constraint = relationConstraint(2, ["10"], "ordered", "O");
    expect(constraint.allowed).toEqual([1]);
  });
});

const satisfyingAssignments = (graph: GraphDefinition) => {
  const solutions: Record<string, 0 | 1>[] = [];
  const directions = emptyDirections(graph);

  const search = (edgeIndex: number) => {
    if (edgeIndex === graph.edges.length) {
      solutions.push({ ...directions } as Record<string, 0 | 1>);
      return;
    }

    const edge = graph.edges[edgeIndex];
    for (const direction of [0, 1] as const) {
      directions[edge.id] = direction;
      const viable = graph.vertices.every(
        (vertex) => analyzeVertex(graph, directions, vertex).state !== "impossible",
      );
      if (viable) search(edgeIndex + 1);
    }
    directions[edge.id] = null;
  };

  search(0);
  return solutions;
};

const boundaryMask = (graph: GraphDefinition, directions: Record<string, 0 | 1>) => {
  const boundary = graph.edges.filter((edge) => edge.ends.some((end) => !("vertex" in end)));
  return boundary.reduce((mask, edge, index) => {
    const internalIndex = edge.ends.findIndex((end) => "vertex" in end) as 0 | 1;
    return mask | (Number(directions[edge.id] === internalIndex) << index);
  }, 0);
};

describe("example suite", () => {
  it.each(EXAMPLES.filter(({ id }) => id !== "all-equalizer-k4").map((example) => [example.title, example] as const))(
    "%s has a satisfying orientation",
    (_, graph) => expect(satisfyingAssignments(graph).length).toBeGreaterThan(0),
  );

  it("the two-vertex gadget has exactly the 1-in-4 boundary relation", () => {
    const graph = EXAMPLES.find(({ id }) => id === "one-in-four")!;
    const masks = new Set(satisfyingAssignments(graph).map((solution) => boundaryMask(graph, solution)));
    expect([...masks].sort((a, b) => a - b)).toEqual([1, 2, 4, 8]);
  });

  it("the parsimonious gadget uniquely realizes every 2-in-4 boundary state", () => {
    const graph = EXAMPLES.find(({ id }) => id === "parsimonious-two-in-four")!;
    const counts = new Map<number, number>();
    for (const solution of satisfyingAssignments(graph)) {
      const mask = boundaryMask(graph, solution);
      counts.set(mask, (counts.get(mask) ?? 0) + 1);
    }
    expect([...counts.entries()].sort(([a], [b]) => a - b)).toEqual([
      [3, 1], [5, 1], [6, 1], [9, 1], [10, 1], [12, 1],
    ]);
  });

  it("the planar crossover uniquely propagates both crossing signals", () => {
    const graph = EXAMPLES.find(({ id }) => id === "crossover")!;
    const counts = new Map<number, number>();
    for (const solution of satisfyingAssignments(graph)) {
      const mask = boundaryMask(graph, solution);
      counts.set(mask, (counts.get(mask) ?? 0) + 1);
    }
    expect([...counts.entries()].sort(([a], [b]) => a - b)).toEqual([
      [3, 1], [5, 1], [10, 1], [12, 1],
    ]);
  });

  it("Figure 4 has the two orientations induced by its satisfying assignments", () => {
    const graph = EXAMPLES.find(({ id }) => id === "figure-4-one-in-three-go")!;
    expect(graph.vertices).toHaveLength(16);
    expect(graph.edges).toHaveLength(24);
    expect(satisfyingAssignments(graph)).toHaveLength(2);

    const gridPoints = [
      ...graph.vertices,
      ...graph.edges.flatMap(({ route }) => route ?? []),
    ];
    for (const { x, y } of gridPoints) {
      expect(Number.isInteger((x - 70) / 80)).toBe(true);
      expect(Number.isInteger((1020 - y) / 80)).toBe(true);
    }
  });

  it("the equalizer K₄ has two satisfying orientations", () => {
    const graph = EXAMPLES.find(({ id }) => id === "equalizer-k4-puzzle")!;
    const solutions = satisfyingAssignments(graph);
    expect(solutions).toHaveLength(2);

    for (const solution of solutions) {
      expect(["el", "er", "em"].every((edgeId) => solution[edgeId] === 1)).toBe(true);
    }
  });

  it("the all-equalizer K₄ is impossible", () => {
    const graph = EXAMPLES.find(({ id }) => id === "all-equalizer-k4")!;
    expect(satisfyingAssignments(graph)).toHaveLength(0);
  });

  it("the two-equalizer K₄ has two satisfying orientations", () => {
    const graph = EXAMPLES.find(({ id }) => id === "two-equalizer-k4")!;
    expect(satisfyingAssignments(graph)).toHaveLength(2);
    expect(graph.vertices.filter(({ constraint }) => constraint.shortLabel === "=").map(({ id }) => id)).toEqual([
      "left",
      "right",
    ]);
  });

  it("the triangular prism has four pairs of directed cycles", () => {
    const graph = EXAMPLES.find(({ id }) => id === "triangular-prism")!;
    const solutions = satisfyingAssignments(graph);
    expect(solutions).toHaveLength(4);

    for (const solution of solutions) {
      expect(["match-top", "match-left", "match-right"].every(
        (edgeId) => solution[edgeId] === 1,
      )).toBe(true);
    }

    const vertices = Object.fromEntries(graph.vertices.map((vertex) => [vertex.id, vertex]));
    for (const prefix of ["outer", "inner"]) {
      const top = vertices[`${prefix}-top`];
      const left = vertices[`${prefix}-left`];
      const right = vertices[`${prefix}-right`];
      const base = Math.hypot(right.x - left.x, right.y - left.y);
      const side = Math.hypot(top.x - left.x, top.y - left.y);
      expect(Math.abs(base - side) / base).toBeLessThan(0.002);
    }
  });

  it("the all-equalizer cube has its two bipartite orientations", () => {
    const graph = EXAMPLES.find(({ id }) => id === "all-equalizer-cube")!;
    expect(satisfyingAssignments(graph)).toHaveLength(2);

    const vertices = Object.fromEntries(graph.vertices.map((vertex) => [vertex.id, vertex]));
    expect(vertices["outer-ne"].x - vertices["outer-nw"].x).toBe(
      vertices["outer-sw"].y - vertices["outer-nw"].y,
    );
    expect(vertices["inner-ne"].x - vertices["inner-nw"].x).toBe(
      vertices["inner-sw"].y - vertices["inner-nw"].y,
    );
  });
});
