import { afterEach, describe, expect, it, vi } from "vitest";
import { render } from "solid-js/web";
import { Visualizer, serializeGraphSvg } from "../src/Visualizer.civet";

let dispose: (() => void) | undefined;

afterEach(() => {
  vi.restoreAllMocks();
  dispose?.();
  dispose = undefined;
  window.localStorage.clear();
  delete document.documentElement.dataset.theme;
  document.body.replaceChildren();
});

describe("example selection", () => {
  it("uses the favicon artwork as the masthead brand mark", () => {
    const root = document.createElement("div");
    dispose = render(() => <Visualizer />, root);

    const mark = root.querySelector<HTMLImageElement>("img.brand-mark");
    expect(mark?.getAttribute("src")).toBe("./favicon.svg");
    expect(mark?.getAttribute("alt")).toBe("");
    expect(root.querySelector("h1")?.getAttribute("aria-label")).toBe("Graph Orientation Playground");
    expect(root.querySelector(".title-small-caps")?.textContent).toBe("GRAPH ORIENTATION PLAYGROUND");
    expect(root.textContent).not.toContain("Interactive constraint lab");
  });

  it("toggles and remembers the color theme", () => {
    const root = document.createElement("div");
    document.body.append(root);
    dispose = render(() => <Visualizer />, root);

    const toggle = root.querySelector<HTMLButtonElement>(".theme-toggle")!;
    const initial = document.documentElement.dataset.theme;
    expect(toggle.getAttribute("aria-pressed")).toBe(initial === "dark" ? "true" : "false");

    toggle.click();

    const changed = initial === "dark" ? "light" : "dark";
    expect(document.documentElement.dataset.theme).toBe(changed);
    expect(window.localStorage.getItem("graph-orientation-theme")).toBe(changed);
    expect(toggle.getAttribute("aria-pressed")).toBe(changed === "dark" ? "true" : "false");
    expect(toggle.querySelector(".theme-toggle__icon")?.textContent).toBe(changed === "dark" ? "☾" : "☀");
    expect(toggle.querySelector(".theme-toggle__label")).toBeNull();
  });

  it("replaces the selected example and SVG diagram without repeating its title", () => {
    const root = document.createElement("div");
    dispose = render(() => <Visualizer />, root);

    const select = root.querySelector<HTMLSelectElement>("#example")!;
    expect(select.selectedOptions[0].textContent).toBe("Directed cycle");
    expect(root.querySelector(".control-panel h2")).toBeNull();
    expect(root.querySelectorAll(".edge-hit")).toHaveLength(4);

    select.value = "one-in-four";
    select.dispatchEvent(new Event("change", { bubbles: true }));

    expect(select.selectedOptions[0].textContent).toBe("1-in-4 simulation");
    expect(root.querySelectorAll(".edge-hit")).toHaveLength(5);
  });

  it("renders Figure 4 edges along their orthogonal routes", () => {
    const root = document.createElement("div");
    dispose = render(() => <Visualizer />, root);

    const select = root.querySelector<HTMLSelectElement>("#example")!;
    select.value = "figure-4-one-in-three-go";
    select.dispatchEvent(new Event("change", { bubbles: true }));

    const vertexTypeRows = root.querySelectorAll(".vertex-type-list .vertex-type");
    expect(vertexTypeRows).toHaveLength(3);
    expect(root.querySelectorAll(".vertex-type-symbol > span")).toHaveLength(3);
    expect(root.querySelector(".vertex-types table")).toBeNull();
    expect(root.querySelector(".vertex-types")?.textContent).toContain("All edges point inward or all point outward");
    expect([...root.querySelectorAll(".vertex-label")].map(({ textContent }) => textContent)).toContain("=");
    expect(root.querySelectorAll(".vertex-label--single-character")).toHaveLength(12);
    expect([...root.querySelectorAll(".vertex-label")].map(({ textContent }) => textContent)).toContain("1∕3");
    expect([...root.querySelectorAll(".vertex-label")].map(({ textContent }) => textContent)).toContain("2∕3");
    expect(root.querySelectorAll(".vertex-annotation")).toHaveLength(16);
    expect(root.querySelectorAll(".vertex-body")).toHaveLength(16);
    expect(root.querySelector(".vertex-shape rect")).toBeNull();

    const outerCycleEdge = root.querySelector<SVGPathElement>(
      '.edge-hit[aria-label^="x-between-2:"]',
    );
    expect(outerCycleEdge?.getAttribute("d")).toBe(
      "M 903 60 L 1430 60 L 1430 140 L 70 140 L 70 60 L 117 60",
    );

    const literalPairEdge = root.querySelector<SVGPathElement>(
      '.edge-hit[aria-label^="x-pair-1:"]',
    );
    expect(literalPairEdge?.getAttribute("d")).toBe("M 183 60 L 197 60");
  });

  it("places vertex feedback after the vertex type table", () => {
    const root = document.createElement("div");
    dispose = render(() => <Visualizer />, root);

    const types = root.querySelector(".vertex-types")!;
    const feedback = root.querySelector(".legend")!;
    expect(types.parentElement?.classList.contains("vertex-info")).toBe(true);
    expect(feedback.parentElement).toBe(types.parentElement);
    expect(feedback.querySelector("h3")).toBeNull();
    expect(feedback.querySelectorAll(".legend-grid > span")).toHaveLength(4);
    expect(types.compareDocumentPosition(feedback) & Node.DOCUMENT_POSITION_FOLLOWING).not.toBe(0);

    const status = root.querySelector(".state-card")!;
    const howTo = root.querySelector(".how-to")!;
    expect(feedback.compareDocumentPosition(status) & Node.DOCUMENT_POSITION_FOLLOWING).not.toBe(0);
    expect(status.compareDocumentPosition(howTo) & Node.DOCUMENT_POSITION_FOLLOWING).not.toBe(0);
  });

  it("groups edge visuals before their interaction target for the focus glow", () => {
    const root = document.createElement("div");
    dispose = render(() => <Visualizer />, root);

    const edge = root.querySelector(".edge-group")!;
    const visual = edge.querySelector(".edge-visual")!;
    const hit = edge.querySelector(".edge-hit")!;

    expect(visual.querySelector(".edge-base")).not.toBeNull();
    expect(visual.compareDocumentPosition(hit) & Node.DOCUMENT_POSITION_FOLLOWING).not.toBe(0);
    expect(edge.querySelector(".edge-selection")).toBeNull();
  });

  it("keeps edge progress in the footer below the graph", () => {
    const root = document.createElement("div");
    dispose = render(() => <Visualizer />, root);

    const frame = root.querySelector(".graph-frame")!;
    const footer = root.querySelector(".canvas-footer")!;

    expect(frame.compareDocumentPosition(footer) & Node.DOCUMENT_POSITION_FOLLOWING).not.toBe(0);
    expect(footer.querySelector(".counter")?.textContent).toContain("0 / 4 edges");
    expect(footer.querySelector(".keyboard-note")).not.toBeNull();
    expect(footer.querySelector(".download-button")?.textContent).toContain("Download SVG");
    expect(root.querySelector(".canvas-toolbar")).toBeNull();
  });

  it("serializes a standalone SVG with the current theme and page styles", () => {
    const root = document.createElement("div");
    dispose = render(() => <Visualizer />, root);
    const testStyle = document.createElement("style");
    testStyle.textContent = ".edge-base { stroke: rgb(1 2 3); }";
    document.head.append(testStyle);

    const serialized = serializeGraphSvg(root.querySelector<SVGSVGElement>(".graph-canvas")!, "dark");
    testStyle.remove();

    expect(serialized.startsWith('<?xml version="1.0" encoding="UTF-8"?>\n')).toBe(true);
    const parsed = new DOMParser().parseFromString(serialized, "image/svg+xml");
    expect(parsed.querySelector("parsererror")).toBeNull();
    const svg = parsed.documentElement;
    expect(svg.namespaceURI).toBe("http://www.w3.org/2000/svg");
    expect(svg.getAttribute("data-theme")).toBe("dark");
    expect(svg.getAttribute("width")).toBe("800");
    expect(svg.getAttribute("height")).toBe("560");
    expect(svg.querySelector("style[data-svg-export]")?.textContent).toContain(".edge-base");
    expect(svg.querySelectorAll(".edge-hit")).toHaveLength(4);
  });

  it("downloads the current example with an SVG filename and MIME type", () => {
    const createObjectURL = vi.spyOn(URL, "createObjectURL").mockReturnValue("blob:graph-svg");
    let filename: string | undefined;
    vi.spyOn(HTMLAnchorElement.prototype, "click").mockImplementation(function (this: HTMLAnchorElement) {
      filename = this.download;
    });
    const root = document.createElement("div");
    document.body.append(root);
    dispose = render(() => <Visualizer />, root);

    root.querySelector<HTMLButtonElement>(".download-button")!.click();

    expect(createObjectURL).toHaveBeenCalledOnce();
    expect(createObjectURL.mock.calls[0][0]).toBeInstanceOf(Blob);
    expect((createObjectURL.mock.calls[0][0] as Blob).type).toBe("image/svg+xml;charset=utf-8");
    expect(filename).toBe("cycle-tutorial.svg");
  });

  it("marks the two pairs of synchronizer ports", () => {
    const root = document.createElement("div");
    dispose = render(() => <Visualizer />, root);

    const select = root.querySelector<HTMLSelectElement>("#example")!;
    select.value = "synchronizer";
    select.dispatchEvent(new Event("change", { bubbles: true }));

    const vertex = root.querySelector(".vertex")!;
    expect(vertex.querySelector(".vertex-label--single-character")?.textContent).toBe("S");
    expect(vertex.querySelectorAll(".port-pair-label--0")).toHaveLength(2);
    expect(vertex.querySelectorAll(".port-pair-label--1")).toHaveLength(2);
    expect([...vertex.querySelectorAll(".port-pair-label")].map(({ textContent }) => textContent)).toEqual(["+", "+", "−", "−"]);

    const body = vertex.querySelector(".vertex-body")!;
    const firstPortLabel = vertex.querySelector(".port-pair-label")!;
    expect(vertex.querySelector(".vertex-shape")?.contains(body)).toBe(true);
    expect(body.compareDocumentPosition(firstPortLabel) & Node.DOCUMENT_POSITION_FOLLOWING).not.toBe(0);
    expect(root.querySelector(".vertex-types")?.textContent).toContain("The + ports agree");
  });

  it("enlarges the alternator's one-character label", () => {
    const root = document.createElement("div");
    dispose = render(() => <Visualizer />, root);

    const select = root.querySelector<HTMLSelectElement>("#example")!;
    select.value = "alternator";
    select.dispatchEvent(new Event("change", { bubbles: true }));

    expect(root.querySelector(".vertex-label--single-character")?.textContent).toBe("A");
  });
});
